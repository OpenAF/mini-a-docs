[0.000, "o", "                                                                                                                      \u001b[m\u001b[m\u001b[m\u001b[33;1m \u001b[m\u001b[m\r\n\u001b[m\u001b[33;1m \u001b[m\u001b[m\u001b[m\u001b[3m\u001b[48;5;236m      \\\u001b[m\u001b[3m\u001b[48;5;236m                                                                                                                      \u001b[m\u001b[m\u001b[m\u001b[33;1m \u001b[m\u001b[m\r\n\u001b[m\u001b[33;1m \u001b[m\u001b[m\u001b[m\u001b[3m\u001b[48;5;236m       4\u001b[m\u001b[3m\u001b[48;5;236m                                                                                                                     \u001b[m\u001b[m\u001b[m\u001b[33;1m \u001b[m\u001b[m\u001b[m\u001b[m\r\n\u001b[m\u001b[33;1m╰\u001b[m\u001b[33;1m                                                                                                                             \u001b[m\u001b[33;1m╯\u001b[m\u001b[m\u001b[m\r\n\r\nNow searching is as slow as a plain list! This is why real-world libraries use \u001b[1mself-balancing trees\u001b[m (like AVL or red-black\r\ntrees), which automatically rearrange themselves to stay short and bushy. That's a great next topic if you want to go deeper.\r\n\r\n\u001b[2m─\u001b[m\u001b[2m─\u001b[m\u001b[2m─\u001b[m\u001b[2m"]
