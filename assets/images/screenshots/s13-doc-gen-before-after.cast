[67.307, "o", "# API Documentation\r\n\r\n## src/stringUtils.js\r\n\r\n### toKebabCase(str)\r\nConverts a string to kebab-case.\r\n- Parameters: str (string) - Input string.\r\n- Returns: (string) The kebab-cased string.\r\n\r\n### truncate(str, maxLength)\r\nTruncates a string to a maximum length, appending an ellipsis if cut.\r\n- Parameters: str (string) - Input string; maxLength (number) - Maximum length before truncation.\r\n- Returns: (string) The truncated string.\r\n\r\n## src/mathUtils.js\r\n\r\n### add(a, b)\r\nAdds two numbers.\r\n- Parameters: a (number) - First operand; b (number) - Second operand.\r\n- Returns: (number) The sum of a and b.\r\n\r\n### clamp(value, min, max)\r\nClamps a value between a minimum and maximum.\r\n- Parameters: value (number) - The value to clamp; min (number) - Lower bound; max (number) - Upper bound.\r\n- Returns: (number) The clamped value.\r\n"]
