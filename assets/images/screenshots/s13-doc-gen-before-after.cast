[67.072, "o", "\r\nI have scanned the JavaScript files in \u001b[2m`\u001b[m\u001b[33msrc/\u001b[m\u001b[2m`\u001b[m and generated the API documentation in \u001b[2m`\u001b[m\u001b[33mdocs/api.md\u001b[m\u001b[2m`\u001b[m.\r\n\r\n\u001b[1mDocumentation Details:\u001b[m\r\n- \u001b[1msrc/stringUtils.js\u001b[m\r\n  - \u001b[2m`\u001b[m\u001b[33mtoKebabCase(str)\u001b[m\u001b[2m`\u001b[m: Converts a string to kebab-case.\r\n  - \u001b[2m`\u001b[m\u001b[33mtruncate(str, maxLength)\u001b[m\u001b[2m`\u001b[m: Truncates a string to a maximum length.\r\n- \u001b[1msrc/mathUtils.js\u001b[m\r\n  - \u001b[2m`\u001b[m\u001b[33madd(a, b)\u001b[m\u001b[2m`\u001b[m: Adds two numbers.\r\n  - \u001b[2m`\u001b[m\u001b[33mclamp(value, min, max)\u001b[m\u001b[2m`\u001b[m: Clamps a value between a minimum and maximum.\r\n"]
